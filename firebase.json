{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.zip",
      "frames_150/**",
      "frames/**",
      "canvas_frames/**",
      "**/frames_150/**",
      "**/canvas_frames/**",
      "**/frames/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}

